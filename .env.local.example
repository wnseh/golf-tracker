# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx

# E2E 테스트 계정 (tests/ 참고)
TEST_EMAIL=test@example.com
TEST_PASSWORD=change-me

# Sentry (없으면 비활성 — 로컬/e2e는 비워둔다)
NEXT_PUBLIC_SENTRY_DSN=
# SDK 내부 로그 (전송 확인용, 평소엔 비움)
NEXT_PUBLIC_SENTRY_DEBUG=
# 소스맵 업로드 (Vercel 빌드 환경에만; 없으면 스킵)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
